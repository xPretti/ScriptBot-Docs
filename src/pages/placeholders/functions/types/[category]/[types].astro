---
import { buildFunctionsSidebar, getFunctionPages } from "@src/utils/functions-sidebar-utils";
import StarlightPage from "@astrojs/starlight/components/StarlightPage.astro";
import type { I18nKeys } from "node_modules/@astrojs/starlight/utils/createTranslationSystem";
import PlaceholderContent from "@src/components/placeholders/PlaceholderContent.astro";
import { FUNCTION_MAPPING } from "@src/data/placeholder-data";
import type { ENUM_PLACEHOLDER_CATEGORY_TYPE } from "@src/enums/placeholders-enum";

export const pages = getFunctionPages("/placeholders/functions/types/");

export async function getStaticPaths() {
   return pages.map((page) => ({
      params: {
         category: page.category.toLowerCase(),
         types: page.label,
      },
      props: {
         desc: page.description,
      },
   }));
}

const { category, types } = Astro.params;
const { desc } = Astro.props;

const element = FUNCTION_MAPPING.get(category as ENUM_PLACEHOLDER_CATEGORY_TYPE)?.get(types);

const { sidebarGroups } = buildFunctionsSidebar(pages, (key) => Astro.locals?.t(("placeholder.category." + key) as I18nKeys));
---

<StarlightPage
   frontmatter={{
      title: `${types}`,
      description: desc,
      pageLink: {
         label: Astro.locals?.t("placeholder.function.pagelink.categories" as I18nKeys),
         href: "/placeholders/functions/",
      },
   }}
   sidebar={[
      {
         label: Astro.locals?.t("placeholder.function.title" as I18nKeys),
         items: sidebarGroups,
      },
   ]}
>
   <PlaceholderContent item={element} />
</StarlightPage>
