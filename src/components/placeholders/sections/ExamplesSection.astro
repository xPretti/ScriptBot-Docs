---
import type { PlaceholderInterface } from "@src/interfaces/placeholder-interface";
import { getFunctionExample } from "@src/utils/functions-comp-utils";
import Section from "@src/components/ui/Section.astro";
import CodeBlock from "@src/components/ui/CodeBlock.astro";

interface Props {
   item: PlaceholderInterface;
}

const { item } = Astro.props;

function buildExamples(fn: PlaceholderInterface) {
   if (!fn) return "";

   let result = Astro.locals.t("placeholder.section.example.default") + getFunctionExample(fn);

   if (fn.aliases) {
      result += Astro.locals.t("placeholder.section.example.using_aliases") + getFunctionExample(fn, true);
   }

   if (fn.examples?.length) {
      result += `${Astro.locals.t("placeholder.section.example.other")}${fn.examples.join("\n")}`;
   }

   return result;
}

const codeContent = buildExamples(item);
---

<Section title={Astro.locals.t("placeholder.section.name.examples")}>
   <CodeBlock
      language="java"
      code={codeContent}
   />
</Section>
