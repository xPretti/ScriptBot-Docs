---
interface Props {
   version?: string;
}

const { version } = Astro.props;
---

{
   version && (
      <div class="container">
         <h4 class="version">{Astro.locals.t("placeholder.section.version.available") + " " + version}</h4>
      </div>
   )
}

<style>
   .container {
      display: flex;
      align-items: center;
   }

   .version {
      font-size: 16px;
      color: var(--sl-color-accent);
      margin: 0;
   }
</style>
