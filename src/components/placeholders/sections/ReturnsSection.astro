---
import Section from "@src/components/ui/Section.astro";
import type { FunctionReturns } from "@src/types/functions-type";
import PlaceholderReturn from "../components/PlaceholderReturn.astro";

interface Props {
   returns?: FunctionReturns;
}

const { returns } = Astro.props;
const hasCustomReturns = returns?.error || returns?.success;
---

{
   returns && (
      <Section title={Astro.locals.t("placeholder.section.name.returns")}>
         {hasCustomReturns ? (
            <div class="returnsTypes">
               <PlaceholderReturn
                  title={Astro.locals.t("placeholder.section.return.sucess") + ":"}
                  message={returns.success?.message}
                  type={returns.success?.type}
               />

               <PlaceholderReturn
                  title={Astro.locals.t("placeholder.section.return.error") + ":"}
                  message={returns.error?.message}
                  type={returns.error?.type}
               />
            </div>
         ) : (
            <PlaceholderReturn
               title={Astro.locals.t("placeholder.section.return.any") + ":"}
               message={Astro.locals.t("placeholder.section.return.any.message")}
               type={{
                  type: "void",
                  typeLink: "/references/types",
               }}
            />
         )}
      </Section>
   )
}

<style>
   .returnsTypes {
      display: flex;
      flex-direction: column;
      gap: 0.5em;
   }
</style>
