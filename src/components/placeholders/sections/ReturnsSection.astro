---
import Section from "@src/components/ui/Section.astro";
import type { FunctionReturns } from "@src/types/functions-type";
import PlaceholderReturn from "../components/PlaceholderReturn.astro";

interface Props {
   returns?: FunctionReturns;
}

const { returns } = Astro.props;
const hasCustomReturns = returns?.error || returns?.success;
---

{
   returns && (
      <Section title="Retornos">
         {hasCustomReturns ? (
            <div class="returnsTypes">
               <PlaceholderReturn
                  title="Em caso de sucesso:"
                  message={returns.success?.message}
                  type={returns.success?.type}
               />

               <PlaceholderReturn
                  title="Em caso de erro:"
                  message={returns.error?.message}
                  type={returns.error?.type}
               />
            </div>
         ) : (
            <PlaceholderReturn
               title="Em caso de sucesso ou erro:"
               message="Esta função executa uma ação, mas não retorna nenhum valor ao ser executada."
               type={{
                  type: "void",
                  typeLink: "/references/types",
               }}
            />
         )}
      </Section>
   )
}

<style>
   .returnsTypes {
      display: flex;
      flex-direction: column;
      gap: 0.5em;
   }
</style>
