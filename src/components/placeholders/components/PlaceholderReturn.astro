---
import type { FunctionType } from "@src/types/functions-type";
import PlaceholderParam from "./PlaceholderParam.astro";
import Check from "@lucide/astro/icons/check";
import X from "@lucide/astro/icons/x";

interface Props {
   title: string;
   message?: string;
   type?: FunctionType;
}

const { title, message, type } = Astro.props;
---

{
   message && (
      <div class="returnContainer">
         <div class="titleContainer">
            <p class="title">{title}</p>
         </div>
         <div class="value">
            <p class="message">{message}</p>
            {type && (
               <div class="typeContainer">
                  <span class="label">{Astro.locals.t("placeholder.section.return") + ":"}</span>
                  <PlaceholderParam param={type} />
               </div>
            )}
         </div>
      </div>
   )
}

<style>
   .returnContainer {
      display: flex;
      flex-direction: column;
      margin: 0;
      flex: 1;
      border-radius: 5px;
      background-color: var(--my-color-return-content);
      outline: 1px solid var(--sl-color-gray-6);
   }

   .value {
      padding: 10px;
      margin: 0;
      display: flex;
      flex-direction: column;
      height: 100%;
      justify-content: space-between;
   }

   .message {
      margin: 0;
   }

   .titleContainer {
      display: flex;
      gap: 0.5em;
      background-color: var(--my-color-return-content);
      padding: 5px 5px 5px 10px;
      width: 100%;
   }

   .title {
      margin-top: 0;
      text-align: center;
      font-weight: 500;
      font-size: 0.9rem;
      color: var(--sl-color-gray-3);
   }

   .returnContainer a {
      text-decoration: none;
   }

   .returnContainer a:hover {
      text-decoration: underline;
      text-decoration-color: var(--my-color-function-type);
   }

   .typeContainer {
      display: flex;
      flex-direction: row;
      align-items: center;
      margin-top: 0.5rem;
      gap: 0.5em;
   }

   .label {
      color: var(--sl-color-gray-3);
      font-weight: 500;
      font-size: 0.9rem;
   }

   .type {
      font-weight: bold;
      color: var(--my-color-function-type);
      height: 100%;
   }
</style>
