---
const { title } = Astro.props;
---

<section class="section">
   <h3 class="title">{title}</h3>

   <div class="content">
      <slot />
   </div>
</section>

<style>
   .section {
      display: flex;
      flex-direction: column;
      gap: 0.5rem;
      margin: 1rem 0 0 0;
   }

   .content {
      display: flex;
      flex-direction: column;
      margin: 0;
   }
</style>
