---
// SidebarSearch.astro
import { Search } from "lucide-react";
---

<div class="sidebar-search-container">
   <div class="search-wrapper">
      <span class="search-icon"><Search width={18} /></span>
      <input
         id="sidebar-search"
         type="text"
         placeholder={Astro.locals.t("search.on_sidebar")}
         class="search-input"
         autocomplete="off"
      />
   </div>

   <div class="results-wrapper">
      <div
         id="sidebar-no-results"
         class="no-results hidden"
      >
         <p>{Astro.locals.t("search.no_results")}</p>
         <button
            type="button"
            id="open-global-search"
            class="global-search-btn"
         >
            {Astro.locals.t("search.global")}
         </button>
      </div>
   </div>

   <div class="sidebar-content">
      <slot />
   </div>
</div>

<style>
   .sidebar-search-container {
      display: flex;
      flex-direction: column;
   }
   .search-wrapper {
      position: relative;
      width: 100%;
   }
   .search-input {
      width: 100%;
      padding: 5px 40px 5px 12px;
      border-radius: 0.5rem;
      border: 1px solid var(--sl-color-gray-5);
      background-color: var(--sl-color-black);
      color: var(--sl-color-white);
      outline: none;
      font-size: var(--sl-text-sm);
   }
   .search-input:focus {
      border-color: var(--sl-color-accent);
   }
   .search-icon {
      position: absolute;
      right: 0.75rem;
      top: 50%;
      transform: translateY(-50%);
      opacity: 0.5;
      display: inline-flex;
      align-items: center;
   }
   .results-wrapper {
      position: absolute;
      width: 100%;
      top: 100%;
   }
   .no-results {
      width: 100%;
      padding: 1.5rem 1rem;
      text-align: center;
      font-size: var(--sl-text-xs);
      color: var(--sl-color-gray-3);
      border: 1px dashed var(--sl-color-gray-5);
      border-radius: 0.5rem;
   }
   .global-search-btn {
      background: none;
      border: none;
      color: var(--sl-color-accent);
      border-radius: 0.4rem;
      cursor: pointer;
      font-weight: 600;
      margin-top: 0;
   }
   .hidden {
      display: none !important;
   }
   :global(li.selected > a),
   :global(li.selected > summary .large) {
      color: var(--sl-color-accent-low) !important;
   }
</style>

<script>
   let currentSearchQuery = "";

   // Normalização de texto
   const normalize = (t) =>
      t
         .toLowerCase()
         .normalize("NFD")
         .replace(/[\u0300-\u036f]/g, "");

   const initSidebarSearch = () => {
      const searchInput = document.getElementById("sidebar-search") as HTMLInputElement | null;
      const noResults = document.getElementById("sidebar-no-results");
      // Busca a lista top-level na página inteira ou dentro do container do Starlight
      const sidebarContent = document.querySelector(".top-level") || document.querySelector("sl-sidebar-state-persist .top-level");
      const globalSearchBtn = document.getElementById("open-global-search");

      if (!searchInput || !noResults || !sidebarContent) return;

      const detailsState = new Map();
      sidebarContent.querySelectorAll("details").forEach((d) => detailsState.set(d, (d as HTMLDetailsElement).open));

      function performSearch(query) {
         currentSearchQuery = query;

         const terms = query.trim().split(/\s+/).filter(Boolean).map(normalize);
         const allLi = sidebarContent.querySelectorAll("li");

         noResults.classList.add("hidden");

         if (!terms.length) {
            allLi.forEach((li) => {
               (li as HTMLElement).style.display = "";
               li.classList.remove("selected");
            });
            sidebarContent.querySelectorAll("details").forEach((d) => ((d as HTMLDetailsElement).open = detailsState.get(d)));
            return;
         }

         allLi.forEach((li) => {
            (li as HTMLElement).style.display = "none";
            li.classList.remove("selected");
         });

         let matched = false;
         terms.forEach((term) => {
            allLi.forEach((li) => {
               const text = normalize(li.querySelector("summary .large, a span, a")?.textContent || "");
               if (text.includes(term)) {
                  matched = true;
                  (li as HTMLElement).style.display = "";
                  li.classList.add("selected");

                  // Exibe filhos se houver
                  li.querySelectorAll("li").forEach((c) => ((c as HTMLElement).style.display = ""));

                  // Abre os pais (categories e details)
                  let p = li.parentElement;
                  while (p && p !== sidebarContent) {
                     if (p.tagName === "LI") (p as HTMLElement).style.display = "";
                     if (p.tagName === "DETAILS") (p as HTMLDetailsElement).open = true;
                     p = p.parentElement;
                  }
               }
            });
         });

         if (!matched) {
            noResults.classList.remove("hidden");
         }
      }

      // Restaura busca anterior se houver
      if (currentSearchQuery) {
         searchInput.value = currentSearchQuery;
         performSearch(currentSearchQuery);
      }

      // Handler do campo de busca local
      searchInput.oninput = (e) => {
         performSearch((e.target as HTMLInputElement).value);
      };

      searchInput.onkeydown = (e) => {
         if (e.key === "Escape") {
            searchInput.value = "";
            performSearch("");
            searchInput.blur();
         }
      };

      // Handler do botão de busca global
      if (globalSearchBtn) {
         globalSearchBtn.onclick = (event) => {
            event.stopPropagation();
            const query = searchInput.value;
            const siteSearch = document.querySelector("site-search");
            const dialog = siteSearch?.querySelector("dialog") as HTMLDialogElement | null;
            const frame = siteSearch?.querySelector(".dialog-frame");

            if (dialog && frame) {
               const closeOnOutsideClick = (e: MouseEvent) => {
                  const target = e.target as HTMLElement;
                  const isLink = "href" in (target || {});
                  const outsideFrame = document.body.contains(target) && !frame.contains(target);
                  if (isLink || outsideFrame) {
                     dialog.close();
                  }
               };

               dialog.showModal();
               document.body.toggleAttribute("data-search-modal-open", true);
               window.addEventListener("click", closeOnOutsideClick);

               dialog.addEventListener(
                  "close",
                  () => {
                     document.body.toggleAttribute("data-search-modal-open", false);
                     window.removeEventListener("click", closeOnOutsideClick);
                  },
                  { once: true },
               );

               const inject = () => {
                  const input = dialog.querySelector("input.pagefind-ui__search-input") as HTMLInputElement | null;
                  if (input) {
                     input.value = query;
                     input.dispatchEvent(new Event("input", { bubbles: true }));
                     input.focus();
                  } else {
                     setTimeout(inject, 50);
                  }
               };
               inject();
            }
         };
      }
   };

   // Atalho da tecla / no teclado
   const handleSlash = (e: KeyboardEvent) => {
      const target = e.target;
      const isEditable = target instanceof Element && (["INPUT", "TEXTAREA", "SELECT"].includes(target.tagName) || target.isContentEditable);
      if (e.key === "/" && !isEditable) {
         const searchInput = document.getElementById("sidebar-search");
         if (searchInput) {
            e.preventDefault();
            searchInput.focus();
         }
      }
   };

   document.removeEventListener("keydown", handleSlash, { capture: true });
   document.addEventListener("keydown", handleSlash, { capture: true });

   // Executa no carregamento inicial e em navegações via ClientRouter
   document.addEventListener("astro:page-load", initSidebarSearch);
   initSidebarSearch();
</script>
